{
  "name": "valorant-dlss",
  "productName": "Valorant DLSS",
  "version": "0.5.1",
  "private": true,
  "description": "Interface locale et épurée pour le Neural Rendering de Visual Enhancer",
  "author": "Morpheen",
  "license": "MIT",
  "homepage": "https://github.com/nildontsleep/val-dlss#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nildontsleep/val-dlss.git"
  },
  "bugs": {
    "url": "https://github.com/nildontsleep/val-dlss/issues"
  },
  "keywords": [
    "electron",
    "windows",
    "video",
    "neural-rendering",
    "valorant",
    "visual-enhancer",
    "ffmpeg"
  ],
  "main": "src/main/main.js",
  "scripts": {
    "prestart": "node scripts/vendor.js",
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "predist": "node scripts/vendor.js",
    "dist": "electron-builder --config electron-builder.portable.json --win portable --publish never",
    "predist:installer": "node scripts/vendor.js && node scripts/fetch-ffmpeg.js",
    "dist:installer": "electron-builder --config electron-builder.installer.json --win nsis --publish never"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "gsap": "3.15.0"
  }
}
